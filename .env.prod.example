# Copy to .env on the Azure VM; never commit actual credentials.
# Use a published, lowercase GHCR path and a specific commit SHA tag.
APP_IMAGE=ghcr.io/comento-aiagent-1/etf-ai-agent:REPLACE_WITH_COMMIT_SHA
APP_PORT=8501

OPENAI_API_KEY=
ETF_DATA_API_KEY=
DART_API_KEY=

POSTGRES_DB=etf_agent_prod
POSTGRES_USER=etf_prod_user
POSTGRES_PASSWORD=
MONGO_DB=etf_agent_prod
MONGO_ROOT_USERNAME=etf_prod_admin
MONGO_ROOT_PASSWORD=
FAQ_MIN_SIMILARITY=0.3

# Set passwords before the FIRST DB startup. Existing volumes keep their users.
# Single-quote values containing $ or #, for example PASSWORD='your-value'.
