OPENAI_API_KEY=본인의_OpenAI_API_키를_입력하세요
ETF_DATA_API_KEY=본인의_공공데이터포털_키를_입력하세요
DART_API_KEY=본인의_DART_API_키를_입력하세요

# Local development databases (compose.yaml)
POSTGRES_DB=etf_agent
POSTGRES_HOST=127.0.0.1
POSTGRES_USER=etf_user
POSTGRES_PASSWORD=local_postgres_password
POSTGRES_PORT=5432
MONGO_ROOT_USERNAME=etf_admin
MONGO_ROOT_PASSWORD=local_mongo_password
MONGO_PORT=27017
MONGO_HOST=127.0.0.1
MONGO_DB=etf_agent

# Cosine similarity cutoff; tune against your evaluation questions.
FAQ_MIN_SIMILARITY=0.3
